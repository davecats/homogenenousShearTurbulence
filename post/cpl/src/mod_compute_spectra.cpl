! Velocity spectra of the fluctuating field.
!
! x streamwise (u, wavenumber kx=alpha0*ix, ix=0..nx), y vertical (v), z spanwise
! (w, kz=beta0*iz, iz=-nz..nz).  The spectra are resolved in the vertical
! position (every mesh row iy=0..ny-1) and folded in the sign of kz:
!   E_ij(iy,ix,|iz|) = SUM over +-iz of  c * Re[ u_i conj(u_j) ],   c = 1 for ix=0, 2 otherwise
! (c accounts for the half of the x modes that is not stored).  The six
! components are stored in the order 1:uu 2:vv 3:ww 4:uv 5:uw 6:vw (the
! cross-terms are co-spectra).  The values are mode energies, not densities:
! sum_iy w(iy) sum_{ix,iz} E_ij equals the corresponding entry of velstats.dat
! with the y-average weights w(iy) (yavg_w, convenience_postprocess.cpl).
!
! The Reynolds decomposition is the phase-wise one of mod_rey_decomp.cpl, i.e. the
! fluctuation is taken about the mean of the fields in the same phase
! (phase_num); dn=1 gives the usual average over all fields.  The spectra are
! accumulated and averaged phase by phase.  This module must be used after
! accum_means()/mpi_comm_means() and apply_rey_decomp().
!
! Output (statistics/):
!  - spectra.bin: binary, REAL (8 bytes), C order, i.e. an array of shape
!    (dn, 6, ny, nx+1, nz+1) indexed (phase, component, iy, ix, |iz|); no header.
!    Read e.g. with numpy as
!    np.fromfile(name, np.float64).reshape(dn, 6, ny, nx+1, nz+1).
!  - spectra_kx.dat, spectra_kz.dat: text, y-averaged one-dimensional spectra
!    E(kx) (sum over kz) and E(|kz|) (sum over kx), one block per phase.

! Variables in memory
! ------------------------------------
ARRAY(1..dn,1..6,0..ny-1,0..nx,0..nz) OF REAL spec_chunk=0
ARRAY(1..6,0..ny-1,0..nx,0..nz) OF REAL spec_tot
ARRAY(1..dn,0..nx,1..6) OF REAL spec_kx=0
ARRAY(1..dn,0..nz,1..6) OF REAL spec_kz=0

SUBROUTINE accum_spectra()
    LOOP FOR iy=0 TO ny-1
        LOOP FOR ALL ix,iz WITH V(ix,iz,iy):
            c = IF ix=0 THEN 1 ELSE 2
            ik = ABS(iz)
            spec_chunk(phase_num,1,iy,ix,ik) = ~+ c*(u|u).REAL
            spec_chunk(phase_num,2,iy,ix,ik) = ~+ c*(v|v).REAL
            spec_chunk(phase_num,3,iy,ix,ik) = ~+ c*(w|w).REAL
            spec_chunk(phase_num,4,iy,ix,ik) = ~+ c*(u|v).REAL
            spec_chunk(phase_num,5,iy,ix,ik) = ~+ c*(u|w).REAL
            spec_chunk(phase_num,6,iy,ix,ik) = ~+ c*(v|w).REAL
        REPEAT
    REPEAT
END accum_spectra

! MPI sum over the processes, average over the fields of each phase and output of
! the binary file (the phases are appended one at a time, to limit the memory),
! then the one-dimensional spectra in text form.
SUBROUTINE write_spectra()
    INTEGER nslab = 6*ny*(nx+1)*(nz+1)
    STRING filename_spec
    FILE   out_spec
    IF rank=0 THEN
        filename_spec=WRITE(path_to_statistics'spectra.bin')
        out_spec=CREATE(filename_spec)
    END IF
    LOOP FOR np=1 TO dn
        ! MPI sum (spectra available only to process with rank=0)
        MPI_Reduce(spec_chunk(np,1,0,0,0), spec_tot(1,0,0,0), nslab, MPI_DOUBLE, MPI_SUM, 0, MPI_COMM_WORLD)
        IF rank=0 THEN
            ! Divide by number of fields in each phase
            DO spec_tot(c,iy,ix,ik) = ~/ nf_vec(np) FOR ALL c,iy,ix,ik
            ! Binary file: append this phase
            LOOP FOR c=1 TO 6 AND iy=0 TO ny-1
                WRITE BINARY TO out_spec spec_tot(c,iy)
            REPEAT
            ! y-averaged one-dimensional spectra
            LOOP FOR c=1 TO 6 AND iy=0 TO ny-1 AND ix=0 TO nx AND ik=0 TO nz
                spec_kx(np,ix,c) = ~+ yavg_w(iy)*spec_tot(c,iy,ix,ik)
                spec_kz(np,ik,c) = ~+ yavg_w(iy)*spec_tot(c,iy,ix,ik)
            REPEAT
        END IF
    REPEAT
    IF rank=0 THEN
        CLOSE out_spec
        ! 1D streamwise spectra E(kx) = sum over kz
        filename_spec = WRITE(path_to_statistics'spectra_kx.dat')
        out_spec=CREATE(filename_spec)
        WRITE TO out_spec "# phase   ix   kx   Euu   Evv   Eww   Euv   Euw   Evw"
        LOOP FOR np=1 TO dn AND ix=0 TO nx
            WRITE TO out_spec np, ix, alpha0*ix :1.15,
                              spec_kx(np,ix,1) :1.15, spec_kx(np,ix,2) :1.15, spec_kx(np,ix,3) :1.15,
                              spec_kx(np,ix,4) :1.15, spec_kx(np,ix,5) :1.15, spec_kx(np,ix,6) :1.15
        REPEAT
        CLOSE out_spec
        ! 1D spanwise spectra E(|kz|) = sum over kx and over +-kz
        filename_spec = WRITE(path_to_statistics'spectra_kz.dat')
        out_spec=CREATE(filename_spec)
        WRITE TO out_spec "# phase   iz   kz   Euu   Evv   Eww   Euv   Euw   Evw"
        LOOP FOR np=1 TO dn AND ik=0 TO nz
            WRITE TO out_spec np, ik, beta0*ik :1.15,
                              spec_kz(np,ik,1) :1.15, spec_kz(np,ik,2) :1.15, spec_kz(np,ik,3) :1.15,
                              spec_kz(np,ik,4) :1.15, spec_kz(np,ik,5) :1.15, spec_kz(np,ik,6) :1.15
        REPEAT
        CLOSE out_spec
    END IF
END write_spectra
