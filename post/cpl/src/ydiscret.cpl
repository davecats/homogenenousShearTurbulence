! Define wall-normal mesh
! For htcoeff>0 non-uniform grid: higher density at half box
REAL CONSTANT zmin=0
REAL zmax=lz
REAL CONSTANT Lz=zmax-zmin
REAL z(-1..nz+1)
REAL z0
LOOP FOR ALL i
  z0=(i-1)/(nz-1)
  IF htcoeff<eps_num THEN
    z(i)=z0
  ELSE
    IF z0<=0.5 THEN
      z(i)=0.5*(1-1+TANH(2*htcoeff*(z0-0))/TANH(htcoeff))
    ELSE
      z(i)=0.5*(1+1+TANH(2*htcoeff*(z0-1))/TANH(htcoeff))
    END IF
  END IF
REPEAT
z=~*Lz

STRUCTURE[ARRAY(-2..2) OF COMPLEX d0,d1,d2,d4] derivatives(1..nz-1)=0
! Compact fd without shift
SUBROUTINE setup_derivatives()
  COMPLEX M(0..4,0..4),t(0..4)
  LOOP FOR iz=1 TO nz-1 WITH derivatives(iz):
    !d4 
    DO M(i,j)=(z(iz-2+j)-z(iz))**(4-i) FOR ALL i,j; LUdecomp M
    t=0; t(0)=24
    d4(-2+(*))=M\t
    !d0
    DO M(i,j)=(5-i)*(6-i)*(7-i)*(8-i)*(z(iz-2+j)-z(iz))**(4-i) FOR ALL i,j; LUdecomp M
    DO t(i)=SUM {d4(j)*(z(iz+j)-z(iz))**(8-i)} FOR j=-2 TO 2 AND FOR i=0 TO 4
    d0(-2+(*))=M\t
    !d2
    DO M(i,j)=(z(iz-2+j)-z(iz))**(4-i) FOR ALL i,j; LUdecomp M
    t=0; DO t(i)=SUM d0(j)*(4-i)*(3-i)*(z(iz+j)-z(iz))**(2-i) FOR j=-2 TO 2 AND FOR i=0 TO 2
    d2(-2+(*))=M\t    
    !d1
    t=0; DO t(i)=SUM d0(j)*(4-i)*(z(iz+j)-z(iz))**(3-i) FOR j=-2 TO 2 AND FOR i=0 TO 3
    d1(-2+(*))=M\t
  REPEAT
END setup_derivatives

SUBROUTINE pbc(POINTER TO ARRAY(*) OF COMPLEX arr)
  arr(nz)=arr(1);   arr(nz+1)=arr(2)
  arr(0)=arr(nz-1); arr(-1)=arr(nz-2)
END pbc

REAL gamma_x=0,delta_gamma_x=0,gamma_y=0,delta_gamma_y=0
ARRAY(1..nz-1,1..5) OF COMPLEX D0mat=0,D0mat_0
setup_derivatives()
DO D0mat(i,k+3)=derivatives(i).d0(k) FOR i=1 TO nz-1 AND k=-2 TO 2
D0mat_0=D0mat

INLINE COMPLEX FUNCTION spbc_shift(INTEGER ix,iy,i1,i2) = EXP[ I*(ix*alpha0*      gamma_x+iy*beta0*      gamma_y)*[z(i1)-z(i2)]]
INLINE COMPLEX FUNCTION spbc_map(INTEGER ix,iy,i)       = EXP[-I*(ix*alpha0*delta_gamma_x+iy*beta0*delta_gamma_y)* z(i)        ]

INLINE COMPLEX FUNCTION D0(COMPLEX f(*)) = {SUM [d0(k) * spbc_shift[ix, iy, ((iz+k-1) MOD (nz-1))+1, iz+k] * f(k)] FOR k=-2 TO 2}
INLINE COMPLEX FUNCTION D1(COMPLEX f(*)) = {SUM [d1(k) * spbc_shift[ix, iy, ((iz+k-1) MOD (nz-1))+1, iz+k] * f(k)] FOR k=-2 TO 2}
INLINE COMPLEX FUNCTION D2(COMPLEX f(*)) = {SUM [d2(k) * spbc_shift[ix, iy, ((iz+k-1) MOD (nz-1))+1, iz+k] * f(k)] FOR k=-2 TO 2}
INLINE COMPLEX FUNCTION D4(COMPLEX f(*)) = {SUM [d4(k) * spbc_shift[ix, iy, ((iz+k-1) MOD (nz-1))+1, iz+k] * f(k)] FOR k=-2 TO 2}

SUBROUTINE deriv(ARRAY(*) OF COMPLEX f0,f1^; INTEGER ix,iy)
    LOOP FOR iz=1 TO nz-1 WITH derivatives(iz)
        f1(iz)={SUM [d1(k) * spbc_shift[ix, iy, ((iz+k-1) MOD (nz-1))+1, iz+k] * f0(([(iz+k-1) MOD (nz-1)]+1))] FOR k=-2 TO 2}
    REPEAT
    penta_smw_solve(nz-1, D0mat, f1(1..nz-1), f1(1..nz-1))
END deriv

REAL FUNCTION zintegr(REAL f(*))
  RESULT=0
  LOOP FOR iz=1 TO nz-1 BY 2 
    zp1=z(iz+1)-z(iz); zm1=z(iz-1)-z(iz) 
    a1=-1/3*zm1+1/6*zp1+1/6*zp1*zp1/zm1
    a3=+1/3*zp1-1/6*zm1-1/6*zm1*zm1/zp1
    a2=zp1-zm1-a1-a3
    RESULT=~+a1*f(iz-1) + a2*f(iz) + a3*f(iz+1)    
  REPEAT
END zintegr
